{
  "task": "Go2Diagnostic-v0",
  "seed": 7,
  "num_envs": 32,
  "dt": 0.002,
  "decimation": 5,
  "episode_seconds": 4.0,
  "action_scale": 0.1,
  "go2_usd": "/home/autodrive/Isaac/unitree_model/Go2/usd/go2.usd",
  "runner": {
    "seed": 7,
    "num_steps_per_env": 128,
    "save_interval": 1,
    "obs_groups": {"policy": ["policy"], "critic": ["policy"]},
    "logger": "tensorboard",
    "policy": {
      "class_name": "ActorCritic",
      "actor_hidden_dims": [128, 128],
      "critic_hidden_dims": [128, 128],
      "activation": "elu",
      "init_noise_std": 0.3,
      "noise_std_type": "log",
      "actor_obs_normalization": true,
      "critic_obs_normalization": true
    },
    "algorithm": {
      "class_name": "PPO",
      "num_learning_epochs": 4,
      "num_mini_batches": 4,
      "learning_rate": 0.0003,
      "schedule": "fixed",
      "gamma": 0.997,
      "lam": 0.97,
      "entropy_coef": 0.01,
      "desired_kl": 0.01,
      "max_grad_norm": 1.0,
      "value_loss_coef": 1.0,
      "use_clipped_value_loss": true,
      "clip_param": 0.2
    }
  }
}
