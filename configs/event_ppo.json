{
  "task": "Go2PiPERCoupled-Event-18D-v1",
  "seed": 7,
  "num_envs": 32,
  "episode_seconds": 4.0,
  "runner": {
    "seed": 7,
    "num_steps_per_env": 128,
    "save_interval": 10,
    "obs_groups": {"policy": ["policy"], "critic": ["policy"]},
    "logger": "tensorboard",
    "policy": {
      "class_name": "ActorCritic",
      "actor_hidden_dims": [256, 256],
      "critic_hidden_dims": [256, 256],
      "activation": "elu",
      "init_noise_std": 0.5,
      "noise_std_type": "log",
      "actor_obs_normalization": true,
      "critic_obs_normalization": true
    },
    "algorithm": {
      "class_name": "PPO",
      "num_learning_epochs": 5,
      "num_mini_batches": 4,
      "learning_rate": 0.0003,
      "schedule": "adaptive",
      "gamma": 0.99,
      "lam": 0.95,
      "entropy_coef": 0.01,
      "desired_kl": 0.01,
      "max_grad_norm": 1.0,
      "value_loss_coef": 1.0,
      "use_clipped_value_loss": true,
      "clip_param": 0.2
    }
  }
}
