+    def test_position_stop_reaction_couples_to_floating_base(self):
+        for sign in [-1.,1.]:
+            p=self.floating_problem(sign)
+            # Only 0.5mrad remains before a stop; dt=10ms -> 0.05rad/s.
+            lower=np.array([-.05 if sign<0 else -30.])
+            upper=np.array([30. if sign<0 else .05])
+            r=speed_limited_velocity_step(**p,velocity_limits=np.array([30.]),lower=lower,upper=upper)
+            np.testing.assert_allclose(r['velocity'],sign*np.array([-.01,.05]),atol=1e-12,rtol=0.)
+            self.assertLess(r['momentum_residual'],1e-12)
+            self.assertLessEqual(abs(r['torque'][0]),p['effort'][0])
+
+    def test_incompatible_stop_does_not_override_original_speed_limit(self):
+        with self.assertRaisesRegex(ValueError,'incompatible'):
+            speed_limited_velocity_step(**self.floating_problem(),velocity_limits=np.array([.1]),
+                                        lower=np.array([.2]),upper=np.array([.3]))
+
+    def test_contact_stop_solution_matches_independent_primal_qp(self):
+        p=self.contact_problem(0.)
+        r=speed_limited_velocity_step(**p,velocity_limits=np.array([30.]),
+                                      lower=np.array([-.5]),upper=np.array([.1]))
+        S=p['selection'];A=p['mass']+p['dt']*(S*(p['kd']+p['dt']*p['kp']))@S.T
+        b=p['mass']@p['velocity']+p['dt']*S@(p['kp']*p['target_error'])
+        oracle=minimize(lambda v:.5*v@A@v-b@v,np.zeros(4),jac=lambda v:A@v-b,
+            constraints=LinearConstraint(np.vstack([p['jacobian'][2],S.T]),[0.,-.5],[np.inf,.1]),
+            method='SLSQP',options={'ftol':1e-13,'maxiter':200})
+        self.assertTrue(oracle.success)
+        np.testing.assert_allclose(r['velocity'],oracle.x,atol=1e-6,rtol=0.)
