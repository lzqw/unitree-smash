+def joint_velocity_interval(limits,lower=None,upper=None):
+    """Intersect original speed bounds with optional position-stop bounds.
+
+    These bounds enter the coupled impulse solve, never a post-step clipping.
+    Infeasible intervals fail explicitly; no constraint is silently relaxed.
+    """
+    limits=np.asarray(limits,float)
+    lo=-limits.copy() if lower is None else np.asarray(lower,float)
+    hi=limits.copy() if upper is None else np.asarray(upper,float)
+    if (lo.shape!=limits.shape or hi.shape!=limits.shape or
+            not np.isfinite(lo).all() or not np.isfinite(hi).all()):
+        raise ValueError('Invalid joint constraint interval')
+    lo=np.maximum(lo,-limits);hi=np.minimum(hi,limits)
+    if np.any(lo>hi):raise ValueError('Position and speed constraint intervals incompatible')
+    return lo,hi
+
